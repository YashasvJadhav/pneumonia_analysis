# Flask configuration
# A secure secret key for cryptographic signing of sessions/tokens
SECRET_KEY=your_flask_secret_key_here

# Database configuration
# PostgreSQL connection string: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/pneumonia_analysis

# Machine learning model path (absolute or relative to Backend folder)
MODEL_PATH=ml_models/pneumonia_densenet121.keras

# JWT configuration
# Token expiration duration in days
JWT_EXPIRATION_DAYS=7
